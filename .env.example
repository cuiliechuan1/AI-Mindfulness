# EdgeOne Makers server-side environment variables.
# Leave all values blank in Git. Set real values only in the Makers environment.

# Internal-preview password. Use a long random value; never expose it to frontend code.
INTERNAL_TEST_PASSWORD=

# Base64-encoded PKCS#8 ECDSA P-256 private key used to sign short-lived sessions.
INTERNAL_TEST_SIGNING_PRIVATE_KEY=
